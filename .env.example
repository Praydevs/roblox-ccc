# Copy to .env and adjust. The server reads process.env, so these also work inline:
#   PUBLIC_URL=https://elow.cc node server/server.js

PORT=5175
HOST=127.0.0.1

# Public origin baked into loadstring URLs and OAuth redirects.
PUBLIC_URL=https://elow.cc

# Account database (Lovable app). When ACCOUNT_API_KEY is set, signup/login/session
# are handled by that service and no password hash is stored here.
ACCOUNT_API_URL=https://cloud-credential-compass.lovable.app
ACCOUNT_API_KEY=

# Optional Discord sign-in. Leave blank to hide the button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SEED=0 starts with an empty database instead of the demo seed.
# SEED=0
